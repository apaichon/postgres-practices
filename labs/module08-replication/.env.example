# Use a unique project and three unused ports per student.
COMPOSE_PROJECT_NAME=postgres-practices-m8_xx
M8_PG1_PORT=55811
M8_PG2_PORT=55812
M8_PG3_PORT=55813
# Set different random hexadecimal secrets. Real .env files are ignored by git.
M8_ADMIN_PASSWORD=replace_with_random_hex
M8_REPLICATION_PASSWORD=replace_with_another_random_hex
