# make lab8-init creates private credentials. Keep this .env with its volumes.
# Use a different project name and unused host ports for each student stack.
COMPOSE_PROJECT_NAME=postgres-practices-m8
M8_PRIMARY_PORT=55811
M8_REPLICA_PORT=55812
M8_REPLICA2_PORT=55813
M8_SUBSCRIBER_PORT=55814
M8_POOL_PORT=55820
M8_ADMIN_PASSWORD=replace_with_random_hex
M8_REPLICATION_PASSWORD=replace_with_another_random_hex
M8_APP_PASSWORD=replace_with_app_random_hex
