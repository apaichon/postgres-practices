    {
      "id": 8,
      "title": "Student role sessions / role limit",
      "type": "stat",
      "description": "Uses this role's real connection limit, not the whole cluster limit. No value if the role is unlimited.",
      "gridPos": {
        "x": 18,
        "y": 4,
        "w": 6,
        "h": 4
      },
      "datasource": {
        "type": "prometheus",
        "uid": "$datasource"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "100*claimsure_m9_capacity_own_role_sessions{job=\"postgres\",instance=\"postgres:5432/$database\",datname=\"$database\"}/(claimsure_m9_capacity_own_role_limit{job=\"postgres\",instance=\"postgres:5432/$database\",datname=\"$database\"}>0)",
          "legendFormat": "{{datname}}",
          "instant": true,
          "range": false
        }
