    {
      "id": 12,
      "title": "Database deadlocks in last 5 minutes",
      "type": "timeseries",
      "description": "Prometheus increase is extrapolated and may be fractional. Confirm the exact 40P01 event in worker logs/SQL counter. History remains after reset.",
      "gridPos": {
        "x": 12,
        "y": 15,
        "w": 12,
        "h": 7
      },
      "datasource": {
        "type": "prometheus",
        "uid": "$datasource"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "increase(pg_stat_database_deadlocks{job=\"postgres\",instance=\"postgres:5432/$database\",datname=\"$database\"}[5m])",
