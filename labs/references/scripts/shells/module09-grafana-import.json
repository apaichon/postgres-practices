{
  "id": null,
  "uid": null,
  "title": "Module 9 - Student PostgreSQL Monitoring",
  "tags": [
    "claimsure",
    "module09",
    "student-lab"
  ],
  "schemaVersion": 40,
  "version": 1,
  "editable": true,
  "timezone": "browser",
  "refresh": "10s",
  "time": {
    "from": "now-15m",
    "to": "now"
  },
  "description": "Student-filtered monitoring lab. Prometheus job postgres, 30s scrapes. No standby/host exporter or business p99 is deployed. Use SQL evidence and the runbook.",
  "annotations": {
    "list": []
  },
  "panels": [
    {
      "id": 1,
      "title": "1. Exporter HTTP scrape UP",
      "type": "stat",
      "description": "HTTP scrape only. An exporter can be reachable while PostgreSQL is down; check panel 2 too.",
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 6,
        "h": 4
      },
      "datasource": {
        "type": "prometheus",
        "uid": "$datasource"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "up{job=\"postgres\",instance=\"postgres:5432/$database\"}",
          "legendFormat": "{{datname}}",
          "instant": true,
          "range": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "green",
                "value": 1
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "area",
        "textMode": "auto"
      }
    },
    {
      "id": 2,
      "title": "2. PostgreSQL connection healthy",
      "type": "stat",
      "description": "Must be 1. A missing/wrong claim_monitor role makes this 0 even if HTTP up=1.",
