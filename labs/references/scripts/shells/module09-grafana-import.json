          "refId": "A",
          "expr": "rate(pg_stat_database_blks_hit{job=\"postgres\",instance=\"postgres:5432/$database\",datname=\"$database\"}[$__rate_interval])/(rate(pg_stat_database_blks_hit{job=\"postgres\",instance=\"postgres:5432/$database\",datname=\"$database\"}[$__rate_interval])+rate(pg_stat_database_blks_read{job=\"postgres\",instance=\"postgres:5432/$database\",datname=\"$database\"}[$__rate_interval]))",
          "legendFormat": "cache hit fraction",
          "instant": false,
          "range": true
