    {
      "id": 16,
      "title": "Database cache hit fraction (recent)",
      "type": "timeseries",
      "description": "No value if both rates are zero. This is a PostgreSQL block-cache ratio, not an OS-cache or end-to-end latency measurement.",
      "gridPos": {
        "x": 12,
        "y": 29,
        "w": 12,
        "h": 7
      },
      "datasource": {
        "type": "prometheus",
        "uid": "$datasource"
