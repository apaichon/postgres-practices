# Run python3 labs/supabase/lab.py init from the repository root.
# The helper generates a private .env with matching JWT/API keys.
# Do not start with these placeholder secrets or commit the generated .env.
COMPOSE_PROJECT_NAME=postgres-practices-m10
BIND_ADDRESS=127.0.0.1
API_GW_HTTP_PORT=18000
DB_SESSION_PORT=15480
DB_TRANSACTION_PORT=16543
SUPABASE_PUBLIC_URL=http://127.0.0.1:18000
API_EXTERNAL_URL=http://127.0.0.1:18000/auth/v1
SITE_URL=http://localhost:3000
ADDITIONAL_REDIRECT_URLS=

# Internal PostgreSQL port stays 5432; host pooler ports are separate above.
POSTGRES_HOST=db
POSTGRES_PORT=5432
POSTGRES_DB=postgres
POSTGRES_PASSWORD=change-me-generated-by-init
JWT_SECRET=change-me-generated-by-init
ANON_KEY=change-me-generated-by-init
SERVICE_ROLE_KEY=change-me-generated-by-init
JWT_EXPIRY=3600
DASHBOARD_USERNAME=claimsure
DASHBOARD_PASSWORD=change-me-generated-by-init
SECRET_KEY_BASE=change-me-generated-by-init
REALTIME_DB_ENC_KEY=change-me-generated-by-init
VAULT_ENC_KEY=change-me-generated-by-init
PG_META_CRYPTO_KEY=change-me-generated-by-init
S3_PROTOCOL_ACCESS_KEY_ID=change-me-generated-by-init
S3_PROTOCOL_ACCESS_KEY_SECRET=change-me-generated-by-init

# This pinned upstream stack defaults to legacy HS256 JWT keys.
# Asymmetric/opaque API keys need a separate, coordinated upstream migration.
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=
ANON_KEY_ASYMMETRIC=
SERVICE_ROLE_KEY_ASYMMETRIC=
JWT_JWKS=

STUDIO_DEFAULT_ORGANIZATION=ClaimSure Academy
STUDIO_DEFAULT_PROJECT=ClaimSure Self-hosted Lab
OPENAI_API_KEY=
PGRST_DB_SCHEMAS=public,graphql_public
PGRST_DB_MAX_ROWS=1000
PGRST_DB_EXTRA_SEARCH_PATH=public

# Admin creates confirmed demo users; public signup and phone signup are off.
DISABLE_SIGNUP=true
ENABLE_EMAIL_SIGNUP=true
ENABLE_EMAIL_AUTOCONFIRM=false
ENABLE_ANONYMOUS_USERS=false
ENABLE_PHONE_SIGNUP=false
ENABLE_PHONE_AUTOCONFIRM=false
SMTP_ADMIN_EMAIL=admin@claimsure.example.com
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_SENDER_NAME=ClaimSure Lab
MAILER_URLPATHS_INVITE=/auth/v1/verify
MAILER_URLPATHS_CONFIRMATION=/auth/v1/verify
MAILER_URLPATHS_RECOVERY=/auth/v1/verify
MAILER_URLPATHS_EMAIL_CHANGE=/auth/v1/verify

GLOBAL_S3_BUCKET=claimsure
STORAGE_TENANT_ID=claimsure-lab
REGION=local
IMGPROXY_AUTO_WEBP=true
FUNCTIONS_VERIFY_JWT=true
FUNCTIONS_MEMORY_LIMIT=512m
POOLER_TENANT_ID=claimsure
POOLER_DEFAULT_POOL_SIZE=10
POOLER_MAX_CLIENT_CONN=100
POOLER_DB_POOL_SIZE=5

# Synthetic teaching accounts only; never use these emails for real people.
DEMO_BKK_EMAIL=adjuster.bkk@claimsure.example.com
DEMO_CM_EMAIL=adjuster.cm@claimsure.example.com
DEMO_PASSWORD=change-me-generated-by-init
